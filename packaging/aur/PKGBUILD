pkgname=libember
pkgver=0.1.1
pkgrel=1
pkgdesc="An independent, modern C++ client for Firebase services, in one header"
arch=('any')
url="https://github.com/da0x/libember"
license=('Apache-2.0')
depends=('botan')
optdepends=('openssl: TLS from OpenSSL instead, with -DEMBER_TLS_OPENSSL')
source=("$pkgname-$pkgver.tar.gz::https://github.com/da0x/libember/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

check() {
	cd "$pkgname-$pkgver"
	# It must build with g++ and the TLS library alone.
	g++ -std=c++23 -Wall -Wextra -Werror -Iinclude examples/listen.cpp -o /dev/null $(pkg-config --cflags --libs botan-3)
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm644 include/ember.hpp "$pkgdir/usr/include/ember.hpp"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
